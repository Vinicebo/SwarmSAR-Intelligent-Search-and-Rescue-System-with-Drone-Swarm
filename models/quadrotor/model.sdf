<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="quadrotor">
    <static>false</static>

    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.03</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 0.5 0.15</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 0.5 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.8 1</ambient>
          <diffuse>0.1 0.1 0.8 1</diffuse>
        </material>
      </visual>

      <!-- IMU -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>drone_1</namespace>
            <remapping>~/out:=imu</remapping>
          </ros>
        </plugin>
      </sensor>

      <!-- GPS -->
      <sensor name="gps_sensor" type="gps">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <plugin name="gps_plugin" filename="libgazebo_ros_gps_sensor.so">
          <ros>
            <namespace>drone_1</namespace>
            <remapping>~/out:=gps</remapping>
          </ros>
        </plugin>
      </sensor>

      <!-- LiDAR -->
      <sensor name="lidar_sensor" type="ray">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <pose>0 0 0.1 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.2</min>
            <max>20.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
        <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>drone_1</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>base_link</frame_name>
        </plugin>
      </sensor>

      <!-- Camera -->
      <sensor name="camera_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <pose>0.2 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>drone_1</namespace>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>base_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- Hover thrust control: accepts geometry_msgs/Wrench on drone_1/force -->
    <plugin name="hover_force_plugin" filename="libgazebo_ros_force.so">
      <ros>
        <namespace>drone_1</namespace>
        <remapping>gazebo_ros_force:=force</remapping>
      </ros>
      <link_name>base_link</link_name>
    </plugin>

    <!-- Ground-truth pose, useful for debugging and metrics before GPS fusion exists -->
    <plugin name="p3d_plugin" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>drone_1</namespace>
        <remapping>odom:=ground_truth_odom</remapping>
      </ros>
      <body_name>base_link</body_name>
      <update_rate>30</update_rate>
    </plugin>

  </model>
</sdf>
