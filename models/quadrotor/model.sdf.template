<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="quadrotor">
    <static>false</static>

    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.03</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 0.5 0.15</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 0.5 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.8 1</ambient>
          <diffuse>0.1 0.1 0.8 1</diffuse>
        </material>
      </visual>

      <!-- IMU: processed by the world-level Imu system -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>{drone_id}/imu</topic>
      </sensor>

      <!-- GPS: processed by the world-level NavSat system -->
      <sensor name="navsat_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>{drone_id}/gps</topic>
      </sensor>

      <!-- LiDAR: rendering-based, processed by the world-level Sensors system -->
      <sensor name="lidar_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>{drone_id}/scan</topic>
        <pose>0 0 0.1 0 0 0</pose>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.2</min>
            <max>20.0</max>
            <resolution>0.02</resolution>
          </range>
        </lidar>
      </sensor>

      <!-- Camera: rendering-based, processed by the world-level Sensors system.
           Nothing subscribes to this yet — victim detection (search module)
           doesn't land until a later phase. Uncompressed sensor_msgs/Image at
           640x480/30Hz is ~27 MB/s per drone; bridged through one shared
           parameter_bridge process, 30 of those saturate it and starve other
           topics (including GPS) enough that some drones never get their
           first reading and never leave the ground. Kept at a much lower
           rate/resolution so the sensor (and its bridge entry) still exist
           and are easy to test against, without paying 30x full bandwidth
           for frames nobody reads. Raise this back up once search actually
           consumes the feed. See docs/simulation_notes.md. -->
      <sensor name="camera_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>2</update_rate>
        <topic>{drone_id}/camera/image</topic>
        <pose>0.2 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </link>

  </model>
</sdf>
