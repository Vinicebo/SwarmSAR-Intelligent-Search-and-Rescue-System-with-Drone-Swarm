<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="earthquake_city">

    <physics type="ode">
      <real_time_update_rate>250</real_time_update_rate>
      <max_step_size>0.004</max_step_size>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <sky></sky>
    </scene>

    <!-- Placeholder rubble/building obstacles for Phase 3+.
         Real disaster-site geometry (collapsed buildings, debris fields)
         will be added when the collision and mapping modules are testable. -->

  </world>
</sdf>
