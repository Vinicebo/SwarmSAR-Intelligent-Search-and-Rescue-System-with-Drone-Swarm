<?xml version="1.0"?>
<package format="3">
  <name>communication</name>
  <version>0.1.0</version>
  <description>Peer-to-peer communication module for the SwarmSAR drone swarm.</description>
  <maintainer email="viniciusdaluzlcp@gmail.com">Vinícius da Luz</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>swarm_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
